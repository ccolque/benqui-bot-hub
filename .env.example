# --- Globales (una sola app de Meta = un solo webhook) ---
# Token que vos inventás y pegás en Meta > WhatsApp > Configuración > Webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-string-largo
# Meta > Configuración de la app > Básica > Clave secreta de la app
META_APP_SECRET=
# Versión de la Graph API
GRAPH_API_VERSION=v22.0

# --- Tenant: demo ---
# phone_number_id del número (pantalla API Setup de Meta)
TENANT_DEMO_PHONE_NUMBER_ID=
# Token permanente del System User con whatsapp_business_messaging
TENANT_DEMO_ACCESS_TOKEN=
# (Opcional) WhatsApp del operador que recibe los pedidos de la ferretería.
# Con el número de prueba, tiene que estar en la lista de destinatarios de Meta.
TENANT_DEMO_OPERATOR_PHONE=
# (Opcional) API externa para un catálogo. Si no se define, se usa el JSON de src/data/demo/
TENANT_DEMO_FERRETERIA_API_URL=
TENANT_DEMO_FERRETERIA_API_KEY=

# --- Almacenamiento de sesiones, pedidos y turnos (Upstash Redis) ---
# Se crean solas al agregar Upstash desde Vercel > Storage / Marketplace.
# Sin esto se usa memoria y los flujos de varios pasos pueden perder el estado.
KV_REST_API_URL=
KV_REST_API_TOKEN=
